  "steps": [
    { "text": "Sancocha la pechuga en agua con sal. Deshilacha y reserva 2 tazas del caldo.", "timer_min": 20, "uses": ["pechuga de pollo"] },
    { "text": "Remoja el pan en la leche y licúa con los ajíes hasta tener una crema lisa.", "uses": ["pan de molde", "leche evaporada", "ajíes amarillos"] },
    { "text": "Dora la cebolla y el ajo en aceite a fuego medio hasta que estén transparentes. Sazona con sal, pimienta, comino y palillo.", "timer_min": 8, "uses": ["cebolla roja grande", "ajo", "palillo"] },
    { "text": "Agrega la crema de ají y cocina, removiendo para que no se pegue.", "timer_min": 10 },
    { "text": "Incorpora el pollo y el caldo poco a poco hasta lograr una textura cremosa." },
    { "text": "Fuera del fuego, añade el parmesano y las pecanas. Rectifica la sal.", "uses": ["queso parmesano", "pecanas"] },
    { "text": "Sirve sobre papa amarilla en rodajas, con arroz, medio huevo y una aceituna." }
  ],
  "tips": [
    "Con pasta de ají amarillo en vez de ajíes frescos, usa 3 cucharadas.",
    "Si queda muy espeso, aligera con caldo; si queda ralo, agrega un poco más de pan."
  ]
}
