        { "qty": 4, "unit": "", "name": "ajíes amarillos", "note": "sin venas ni pepas", "aisle": "mercado" },
        { "qty": 1, "unit": "", "name": "cebolla roja grande", "note": "picada", "aisle": "mercado" },
        { "qty": 3, "unit": "dientes", "name": "ajo", "aisle": "mercado" },
        { "qty": 4, "unit": "rebanadas", "name": "pan de molde", "note": "sin borde", "aisle": "bodega" },
