      "group": "Para servir",
      "items": [
        { "qty": 4, "unit": "", "name": "papas amarillas", "note": "sancochadas", "aisle": "mercado" },
        { "qty": 2, "unit": "", "name": "huevos duros", "aisle": "bodega" },
        { "qty": 4, "unit": "", "name": "aceitunas de botija", "aisle": "bodega" },
