  "steps": [
    { "text": "Sancocha las papas con cáscara en agua con sal hasta que estén suaves.", "timer_min": 25, "uses": ["papa amarilla"] },
    { "text": "Pélalas en caliente y prénsalas hasta tener un puré sin grumos. Deja enfriar." },
    { "text": "Amasa el puré con la pasta de ají, el jugo de limón, el aceite y la sal.", "uses": ["pasta de ají amarillo", "limones", "aceite vegetal"] },
    { "text": "Mezcla el atún con la mayonesa y la cebolla.", "uses": ["atún", "mayonesa", "cebolla roja"] },
    { "text": "En un molde, alterna una capa de masa, el relleno, las láminas de palta y otra capa de masa.", "uses": ["paltas"] },
    { "text": "Refrigera antes de cortar y servir.", "timer_min": 30 }
  ],
  "tips": [
    "Prensa la papa en caliente: fría se pone chiclosa.",
    "Echa limón sobre la palta para que no se oscurezca."
